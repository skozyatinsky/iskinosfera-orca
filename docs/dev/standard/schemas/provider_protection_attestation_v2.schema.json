{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provider_protection_attestation_v2.schema.json",
  "title": "Live-connector provider protection attestation",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "provider_attestation_id",
    "provider",
    "account_id",
    "repository_provider_id",
    "repository_id",
    "canonical_protected_ref",
    "request_id",
    "nonce",
    "fetched_at",
    "expires_at",
    "requested_endpoint",
    "http_method",
    "response_status",
    "response_headers_sha256",
    "provider_response_sha256",
    "connector_envelope_id",
    "connector_envelope_sha256",
    "connector_service_identity",
    "connector_deployment_identity",
    "connector_key_id",
    "live_connector_verified",
    "controls",
    "issuer",
    "adapter_identity",
    "tool_identity"
  ],
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "provider_attestation_id": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["github", "gitlab"] },
    "account_id": { "type": "string", "minLength": 1 },
    "repository_provider_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "canonical_protected_ref": { "type": "string", "pattern": "^refs/heads/.+" },
    "request_id": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 16 },
    "fetched_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "requested_endpoint": { "type": "string" },
    "http_method": { "const": "GET" },
    "response_status": { "const": 200 },
    "response_headers_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "provider_response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "connector_envelope_id": { "type": "string", "minLength": 1 },
    "connector_envelope_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "connector_service_identity": { "type": "string", "minLength": 1 },
    "connector_deployment_identity": { "type": "string", "minLength": 1 },
    "connector_key_id": { "type": "string", "minLength": 1 },
    "live_connector_verified": { "const": true },
    "issuer": { "const": "trusted-provider-adapter-v2" },
    "adapter_identity": { "type": "string", "minLength": 1 },
    "tool_identity": { "type": "object" },
    "controls": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protected_branch",
        "required_checks",
        "required_reviews",
        "force_push_disabled",
        "branch_deletion_disabled",
        "workflow_changes_protected"
      ],
      "properties": {
        "protected_branch": { "const": true },
        "required_checks": { "const": true },
        "required_reviews": { "const": true },
        "force_push_disabled": { "const": true },
        "branch_deletion_disabled": { "const": true },
        "workflow_changes_protected": { "const": true }
      }
    }
  }
}
