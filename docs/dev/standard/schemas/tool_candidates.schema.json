{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "tool_candidates.schema.json",
  "title": "Реестр кандидатов инженерных инструментов",
  "type": "object",
  "additionalProperties": false,
  "required": ["candidates"],
  "properties": {
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "category",
          "source_repository",
          "discovered_version",
          "discovered_commit",
          "discovered_at",
          "status",
          "languages",
          "claimed_capabilities",
          "potential_benefits",
          "known_risks",
          "license",
          "network_requirements",
          "code_upload",
          "recommended_evaluation",
          "recommended_by",
          "evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^TOOL-CANDIDATE-[A-Za-z0-9._-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "minLength": 1 },
          "source_repository": { "type": "string", "minLength": 1 },
          "discovered_version": { "type": "string", "minLength": 1 },
          "discovered_commit": { "type": "string", "pattern": "^[0-9a-f]{7,40}$" },
          "discovered_at": {
            "type": "string",
            "format": "date",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "status": {
            "enum": ["DISCOVERED", "RECOMMENDED_FOR_EVALUATION", "EVALUATED", "REJECTED"]
          },
          "languages": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "claimed_capabilities": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "potential_benefits": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "known_risks": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "license": { "type": "string", "minLength": 1 },
          "network_requirements": { "type": "string", "minLength": 1 },
          "code_upload": { "type": "boolean" },
          "recommended_evaluation": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "recommended_by": { "type": "string", "minLength": 1 },
          "evidence": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  }
}
