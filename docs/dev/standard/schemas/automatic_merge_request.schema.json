{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "automatic_merge_request.schema.json",
  "title": "Trusted controlled automatic merge request",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schema_version",
    "merge_request_id",
    "repository_id",
    "repository_provider_id",
    "account_id",
    "provider",
    "provider_pr_mr_id",
    "task_id",
    "lease_id",
    "fencing_token",
    "base_commit_sha",
    "candidate_commit_sha",
    "candidate_tree_sha",
    "candidate_diff_sha256",
    "candidate_branch",
    "target_protected_ref",
    "trusted_attestation_id",
    "provider_protection_attestation_id",
    "sandbox_certification_id",
    "trusted_toolchain_identity",
    "policy_version",
    "created_at",
    "expires_at",
    "request_nonce",
    "orchestrator_service_identity",
    "orchestrator_deployment_identity",
    "key_id",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "merge_request_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "repository_provider_id": { "type": "string", "minLength": 1 },
    "account_id": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["github", "gitlab"] },
    "provider_pr_mr_id": { "type": ["string", "integer"] },
    "task_id": { "type": "string", "minLength": 1 },
    "lease_id": { "type": "string", "minLength": 1 },
    "fencing_token": { "type": "integer", "minimum": 1 },
    "base_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "candidate_commit_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "candidate_tree_sha": { "type": "string", "pattern": "^[0-9a-f]{40,64}$" },
    "candidate_diff_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "candidate_branch": { "type": "string", "minLength": 1 },
    "target_protected_ref": { "type": "string", "pattern": "^refs/heads/" },
    "trusted_attestation_id": { "type": "string", "minLength": 1 },
    "provider_protection_attestation_id": { "type": "string", "minLength": 1 },
    "sandbox_certification_id": { "type": "string", "minLength": 1 },
    "trusted_toolchain_identity": {
      "type": "object",
      "required": ["manifest_sha256", "runtime_artifact_digest"],
      "properties": {
        "manifest_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "runtime_artifact_digest": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "policy_version": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "request_nonce": { "type": "string", "minLength": 16 },
    "orchestrator_service_identity": { "type": "string", "minLength": 1 },
    "orchestrator_deployment_identity": { "type": "string", "minLength": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 80 }
  }
}
