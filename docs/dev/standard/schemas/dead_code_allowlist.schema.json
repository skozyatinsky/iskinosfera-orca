{
  "$id": "https://agent-project-standard.local/schemas/dead_code_allowlist.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "entries": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "allowlist_id": {
            "pattern": "^APS-DCA-[0-9]{3,}$",
            "type": "string"
          },
          "category": {
            "enum": [
              "dynamic_entrypoint",
              "production_unreachable",
              "test_only_reachable",
              "unused_import",
              "commented_code"
            ]
          },
          "created_in_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "entrypoint_reference": {
            "type": ["string", "null"]
          },
          "evidence": {
            "items": {
              "oneOf": [
                {
                  "additionalProperties": false,
                  "properties": {
                    "contract_type": {
                      "enum": [
                        "entrypoint",
                        "public_api",
                        "migration",
                        "deprecation",
                        "trusted_manifest",
                        "behavioral_test"
                      ]
                    },
                    "kind": {
                      "const": "json_pointer"
                    },
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "pointer": {
                      "pattern": "^(/.*)?$",
                      "type": "string"
                    },
                    "subject": {
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "minLength": 1,
                          "not": {
                            "pattern": "\\*|(^|/)\\.\\.(/|$)|^/|\\\\"
                          },
                          "type": "string"
                        },
                        "symbol": {
                          "minLength": 1,
                          "not": {
                            "pattern": "\\*"
                          },
                          "type": "string"
                        }
                      },
                      "required": ["path", "symbol"],
                      "type": "object"
                    }
                  },
                  "required": ["kind", "contract_type", "subject", "path", "pointer"],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "anchor": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "contract_type": {
                      "enum": [
                        "entrypoint",
                        "public_api",
                        "migration",
                        "deprecation",
                        "trusted_manifest",
                        "behavioral_test"
                      ]
                    },
                    "kind": {
                      "const": "markdown_anchor"
                    },
                    "path": {
                      "minLength": 1,
                      "type": "string"
                    },
                    "subject": {
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "minLength": 1,
                          "not": {
                            "pattern": "\\*|(^|/)\\.\\.(/|$)|^/|\\\\"
                          },
                          "type": "string"
                        },
                        "symbol": {
                          "minLength": 1,
                          "not": {
                            "pattern": "\\*"
                          },
                          "type": "string"
                        }
                      },
                      "required": ["path", "symbol"],
                      "type": "object"
                    }
                  },
                  "required": ["kind", "contract_type", "subject", "path", "anchor"],
                  "type": "object"
                },
                {
                  "additionalProperties": false,
                  "properties": {
                    "contract_type": {
                      "const": "behavioral_test"
                    },
                    "kind": {
                      "const": "test_node"
                    },
                    "node_id": {
                      "pattern": "^tests/[^\\[]+::[A-Za-z_][A-Za-z0-9_:]*$",
                      "type": "string"
                    },
                    "subject": {
                      "additionalProperties": false,
                      "properties": {
                        "path": {
                          "minLength": 1,
                          "not": {
                            "pattern": "\\*|(^|/)\\.\\.(/|$)|^/|\\\\"
                          },
                          "type": "string"
                        },
                        "symbol": {
                          "minLength": 1,
                          "not": {
                            "pattern": "\\*"
                          },
                          "type": "string"
                        }
                      },
                      "required": ["path", "symbol"],
                      "type": "object"
                    }
                  },
                  "required": ["kind", "contract_type", "subject", "node_id"],
                  "type": "object"
                }
              ]
            },
            "minItems": 2,
            "type": "array",
            "uniqueItems": true
          },
          "owner": {
            "minLength": 1,
            "type": "string"
          },
          "path": {
            "minLength": 1,
            "not": {
              "pattern": "\\*"
            },
            "type": "string"
          },
          "reason": {
            "minLength": 10,
            "type": "string"
          },
          "review_version": {
            "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
            "type": "string"
          },
          "symbol": {
            "minLength": 1,
            "not": {
              "pattern": "\\*"
            },
            "type": "string"
          }
        },
        "required": [
          "allowlist_id",
          "path",
          "symbol",
          "category",
          "reason",
          "entrypoint_reference",
          "owner",
          "created_in_version",
          "review_version",
          "evidence"
        ],
        "type": "object"
      },
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": ["schema_version", "entries"],
  "title": "Dead Code Allowlist",
  "type": "object"
}
