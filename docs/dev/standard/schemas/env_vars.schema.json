{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "env_vars.schema.json",
  "title": "Реестр переменных окружения",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["variable", "required"],
    "additionalProperties": false,
    "properties": {
      "variable": { "type": "string" },
      "required": { "type": "boolean" },
      "default": {},
      "used_in": { "type": "array", "items": { "type": "string" }, "description": "пути в коде" },
      "secret": { "type": "boolean", "description": "содержит секрет — не логировать" },
      "description": { "type": "string" }
    }
  }
}
