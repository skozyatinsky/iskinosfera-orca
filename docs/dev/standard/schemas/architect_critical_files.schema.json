{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-standard.local/schemas/architect_critical_files.schema.json",
  "title": "Architect critical files",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "files"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "purpose", "must_be_tracked"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "must_be_tracked": { "type": "boolean" }
        }
      }
    }
  }
}
