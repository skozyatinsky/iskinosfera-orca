{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "config_fields.schema.json",
  "title": "Реестр полей конфигурации",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["field", "source", "type", "required"],
    "additionalProperties": false,
    "properties": {
      "field": { "type": "string" },
      "source": { "type": "string", "description": ".env / config-файл / pyproject и т.п." },
      "type": { "type": "string" },
      "default": {},
      "allowed_values": { "type": "array", "description": "допустимые значения (enum); опц." },
      "required": { "type": "boolean" },
      "description": { "type": "string" }
    }
  }
}
