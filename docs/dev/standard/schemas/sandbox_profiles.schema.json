{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sandbox_profiles.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profiles"],
  "properties": {
    "schema_version": { "const": "2.0.0" },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "profile_id",
          "adapter",
          "platform",
          "controls",
          "reference_only",
          "conformance_capable",
          "production_certified",
          "external_certification_required_for",
          "external_controls_required"
        ],
        "properties": {
          "profile_id": { "type": "string" },
          "adapter": { "type": "string" },
          "platform": { "type": "string" },
          "controls": { "type": "array", "items": { "type": "string" } },
          "reference_only": { "type": "boolean" },
          "conformance_capable": { "type": "boolean" },
          "production_certified": { "const": false },
          "external_certification_required_for": { "type": "array", "items": { "type": "string" } },
          "external_controls_required": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
