{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-project-standard.local/schemas/architect_path_classification.schema.json",
  "title": "Architect path classification",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "paths"],
  "properties": {
    "schema_version": { "type": "integer", "const": 1 },
    "paths": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "classification", "reason"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "classification": {
            "enum": [
              "active_project",
              "reference_example",
              "fixture",
              "template",
              "archived_material",
              "external_project"
            ]
          },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
