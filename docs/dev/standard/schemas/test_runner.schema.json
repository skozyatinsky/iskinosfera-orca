{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "test_runner.schema.json",
  "title": "Рантайм-контракт для внешней программы-контролёра",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "registry": { "type": "string" },
    "base": { "type": "object", "additionalProperties": { "type": "string" } },
    "cli": { "type": "object" },
    "env": { "type": "array", "items": { "type": "string" } },
    "defaults": {
      "type": "object",
      "properties": {
        "mode": {
          "type": "string",
          "enum": ["smoke", "changed", "affected", "full", "critical", "random"]
        }
      }
    },
    "report": { "type": "string" }
  }
}
