{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "protected_branch_policy.schema.json",
  "title": "Trusted protected branch policy",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "canonical_protected_ref",
    "allowed_protected_refs",
    "automatic_merge_enabled",
    "platform_protection_required",
    "platform_protection_verified",
    "verification_source",
    "human_supervised_post_merge_allowed"
  ],
  "properties": {
    "version": { "const": "1.0" },
    "canonical_protected_ref": { "type": "string", "pattern": "^refs/(heads|remotes)/[^.].+" },
    "allowed_protected_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^refs/(heads|remotes)/[^.].+" }
    },
    "automatic_merge_enabled": { "type": "boolean" },
    "platform_protection_required": { "type": "boolean" },
    "platform_protection_verified": { "type": "boolean" },
    "verification_source": { "type": "string", "minLength": 1 },
    "human_supervised_post_merge_allowed": { "type": "boolean" },
    "required_platform_controls": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "enum": [
          "protected_branch",
          "required_checks",
          "required_reviews",
          "force_push_disabled",
          "workflow_protection",
          "environment_approval"
        ]
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "automatic_merge_enabled": { "const": true } } },
      "then": {
        "properties": {
          "platform_protection_required": { "const": true },
          "platform_protection_verified": { "const": true }
        }
      }
    }
  ]
}
