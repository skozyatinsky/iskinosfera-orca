{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "provider_connector_envelope.schema.json",
  "title": "Signed provider connector transport envelope",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "connector_envelope_id",
    "provider",
    "account_id",
    "repository_provider_id",
    "repository_id",
    "canonical_protected_ref",
    "request_id",
    "nonce",
    "requested_endpoint",
    "http_method",
    "response_status",
    "response_headers_sha256",
    "raw_response",
    "raw_response_sha256",
    "fetched_at",
    "expires_at",
    "connector_service_identity",
    "connector_deployment_identity",
    "key_id",
    "signature"
  ],
  "properties": {
    "schema_version": { "const": "1.0.0" },
    "connector_envelope_id": { "type": "string", "minLength": 1 },
    "provider": { "enum": ["github", "gitlab"] },
    "account_id": { "type": "string", "minLength": 1 },
    "repository_provider_id": { "type": "string", "minLength": 1 },
    "repository_id": { "type": "string", "minLength": 1 },
    "canonical_protected_ref": { "type": "string", "pattern": "^refs/heads/.+" },
    "request_id": { "type": "string", "minLength": 1 },
    "nonce": { "type": "string", "minLength": 16 },
    "requested_endpoint": { "type": "string", "minLength": 1 },
    "http_method": { "const": "GET" },
    "response_status": { "const": 200 },
    "response_headers_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "raw_response": { "type": "object" },
    "raw_response_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "fetched_at": { "type": "string" },
    "expires_at": { "type": "string" },
    "connector_service_identity": { "type": "string", "minLength": 1 },
    "connector_deployment_identity": { "type": "string", "minLength": 1 },
    "key_id": { "type": "string", "minLength": 1 },
    "signature": { "type": "string", "minLength": 80 }
  }
}
