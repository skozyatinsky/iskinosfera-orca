{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "encrypted_env_policy.schema.json",
  "title": "Политика зашифрованного .env (секреты через Git)",
  "type": "object",
  "required": ["format", "encrypted_file", "tool", "loader", "passphrase_env"],
  "additionalProperties": false,
  "properties": {
    "format": {
      "type": "string",
      "enum": ["env.enc"]
    },
    "plaintext_file": {
      "type": "string"
    },
    "encrypted_file": {
      "type": "string"
    },
    "example_file": {
      "type": "string"
    },
    "tool": {
      "type": "string",
      "description": "скрипт шифрования (tools/encrypt_env.py или совместимый)"
    },
    "loader": {
      "type": "string",
      "description": "кто расшифровывает на старте (файл)"
    },
    "passphrase_env": {
      "type": "string",
      "pattern": "^[A-Z][A-Z0-9_]*$"
    },
    "kdf_iterations_min": {
      "type": "integer",
      "minimum": 600000
    }
  }
}
